# ---------------------------------------------------------------------------
# Jules+ environment configuration
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# MongoDB connection string. SERVER ONLY - never exposed to the browser.
MONGO_URI="mongodb://127.0.0.1:27017/jules-plus"

# High-entropy secret used to derive the AES-256-GCM key that encrypts the
# stored Jules API key. SERVER ONLY.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JULES_KEY_ENCRYPTION_SECRET=""

# Optional GitHub token for authenticated server-side research requests.
# SERVER ONLY - never expose this as NEXT_PUBLIC_GITHUB_API_KEY.
# GITHUB_API_KEY="ghp_..."

# Optional. Absolute path to the authorized checkout used by SSH / Checks.
# The API accepts only fixed check IDs (test, typecheck, lint, build), never a
# browser-supplied shell command. Set CHECKS_SOURCE too when this checkout is
# dedicated to one Jules source.
# CHECKS_WORKSPACE_ROOT="/srv/jules-workspaces/owner/repo"
# CHECKS_SOURCE="sources/github/owner/repo"

# Optional. Absolute base URL of the deployed app.
# APP_URL="http://localhost:3000"

# GitHub App OAuth: Connect your GitHub account for agent MCP access.
# Create a GitHub OAuth App at https://github.com/settings/developers
# and set the redirect URI to APP_URL + /api/github/callback
# GITHUB_APP_CLIENT_ID=""
# GITHUB_APP_CLIENT_SECRET=""
# GITHUB_APP_REDIRECT_URI="http://localhost:3000/api/github/callback"
