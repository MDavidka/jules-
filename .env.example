# ---------------------------------------------------------------------------
# Jules+ environment configuration
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# MongoDB connection string. SERVER ONLY - never exposed to the browser.
MONGO_URI="mongodb://127.0.0.1:27017/jules-plus"

# High-entropy secret used to derive the AES-256-GCM key that encrypts the
# stored Jules API key. SERVER ONLY.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JULES_KEY_ENCRYPTION_SECRET=""

# Optional. Absolute base URL of the deployed app.
# APP_URL="http://localhost:3000"
