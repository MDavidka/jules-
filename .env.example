# ---------------------------------------------------------------------------
# Jules+ environment configuration
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# MongoDB connection string. SERVER ONLY - never exposed to the browser.
MONGO_URI="mongodb://127.0.0.1:27017/jules-plus"

# High-entropy secret used to derive the AES-256-GCM keys that encrypt the stored
# Jules AND NVIDIA API keys. Each credential gets its own HKDF-derived key from this
# one secret. SERVER ONLY.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JULES_KEY_ENCRYPTION_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Absolute base URL of the deployed app.
# APP_URL="http://localhost:3000"

# Raises the agent's GitHub rate limit from 60 to 5,000 requests/hour when reading
# public repositories. Never required: the agent only ever issues GET requests to
# public endpoints. A read-only token with no scopes is sufficient.
# GITHUB_TOKEN=""

# Point the chat agent at a self-hosted NVIDIA NIM container instead of the hosted
# build.nvidia.com endpoint. Both speak the same OpenAI-compatible API.
# Defaults to https://integrate.api.nvidia.com/v1
# NVIDIA_API_BASE_URL=""

# NOTE: the NVIDIA API key itself is NOT an environment variable. Like the Jules key,
# it is entered in the app (Settings -> NVIDIA AI Builder), validated against the live
# API, then encrypted and stored in MongoDB.
